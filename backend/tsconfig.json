{
	"$schema": "https://www.schemastore.org/tsconfig",
	"display": "Node 23",
	"_version": "23.0.0",
	"compilerOptions": {
		"module": "nodenext",
		"target": "es2024",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"moduleResolution": "node16",
		"typeRoots": [
			"./node_modules/@types",
			"./node_moduels/vitest"
		]
	},
	"files": [],
	"references": [
		{
			"path": "./tsconfig.app.json"
		},
		{
			"path": "./tsconfig.spec.json"
		}
	]
}
