{
	"$schema": "https://www.schemastore.org/tsconfig",
	"display": "Node next",
	"compilerOptions": {
		"module": "nodenext",
		"strict": true,
		"skipLibCheck": true,
		"typeRoots": [
			"./node_modules/@types",
			"./node_moduels/vitest"
		],
		"rewriteRelativeImportExtensions": true,
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true
	},
	"files": [],
	"references": [
		{
			"path": "./tsconfig.app.json"
		},
		{
			"path": "./tsconfig.spec.json"
		}
	]
}
